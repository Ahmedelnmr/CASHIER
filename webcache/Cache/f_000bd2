// 5. SAVE
// ==========================================
function saveInvoice() {
    if (invoiceItems.length === 0) {
        alert('لا توجد أصناف في الفاتورة');
        return;
    }
    
    var supplierId = document.getElementById('supplierId').value;
    if (!supplierId) {
        alert('اختر المورد');
        return;
    }
    
    if (!confirm('هل أنت متأكد من حفظ الفاتورة؟ سيتم تحديث المخزون والأسعار.')) return;
    
    // Get actual calculated discount value
    var discountValue = document.getElementById('actualDiscount').textContent;
    
    var payload = {
        supplier_id: supplierId,
        invoice_number: document.getElementById('invoiceNumber').value,
        date: document.getElementById('invoiceDate').value,
        items: invoiceItems,
        discount: parseFloat(discountValue) || 0
    };
    
    apiRequest('?page=purchases&action=save', {
        method: 'POST',
        body: payload
    })
    .then(function(res) {
        if (res.success) {
            alert('تم الحفظ بنجاح ✅');
            window.location.href = '?page=purchases';
        } else {
            alert('خطأ: ' + res.message);
        }
    })
    .catch(function(e) {
        console.error(e);
        alert('حدث خطأ في الاتصال');
    });
}

