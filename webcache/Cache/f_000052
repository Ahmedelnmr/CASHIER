    window.setText = function (id, text) {
        var el = document.getElementById(id);
        if (el) el.textContent = text;
    };

    window.getModeLabel = function (mode) {
        var labels = { 'unit': 'وحدة', 'pack': 'عبوة', 'weight': 'وزن', 'custom': 'يدوي' };
        return labels[mode] || mode;
