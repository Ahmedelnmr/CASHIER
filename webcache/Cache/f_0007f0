var items = [{"id":"70","sale_id":"53","product_id":"16","product_name":"Test Product","quantity":"-5.0","price":"100.0","sale_mode":"unit","subtotal":"-500.0","unit_type":"\u0642\u0637\u0639\u0629"}];
