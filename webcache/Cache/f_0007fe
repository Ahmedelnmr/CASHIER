<script>
// Global Scanner Listener
let scanBuffer = '';
let lastKeyTime = 0;
const SCAN_TIMING_THRESHOLD = 100; // ms

document.addEventListener('keydown', function(e) {
    // Scanner timing check
    const currentTime = Date.now();
    if (currentTime - lastKeyTime > SCAN_TIMING_THRESHOLD) {
        scanBuffer = '';
    }
    lastKeyTime = currentTime;

    if (e.ctrlKey || e.altKey || e.metaKey) return;

    if (e.key === 'Enter') {
        if (scanBuffer.length > 0) {
            // Scanner detected (fast typing + Enter)
            e.preventDefault(); // Stop form submission
            console.log('Scanner detected:', scanBuffer);
            
            var targetInput = null;
            var activeId = document.activeElement ? document.activeElement.id : '';

            // 1. Determine Target Field
            if (['barcode', 'barcode2', 'barcode3'].indexOf(activeId) !== -1) {
                // Already focused on a barcode field -> logic handles just the Jump
                targetInput = document.activeElement;
            } else {
                // Not focused -> Find first empty barcode field
                if (!document.getElementById('barcode').value) targetInput = document.getElementById('barcode');
                else if (!document.getElementById('barcode2').value) targetInput = document.getElementById('barcode2');
                else if (!document.getElementById('barcode3').value) targetInput = document.getElementById('barcode3');
                else targetInput = document.getElementById('barcode'); // Fallback to first
                
                // If we weren't focused, fill the value explicitly
                targetInput.value = scanBuffer;
            }

            // 2. Trigger Validation & Visual Feedback
            if (targetInput) {
                // Determine if we need to manually trigger check (if not focused, no blur event)
                var wasFocused = (document.activeElement === targetInput);
                
                // Flash effect
                targetInput.style.backgroundColor = '#dcfce7';
                setTimeout(function() { targetInput.style.backgroundColor = ''; }, 500);

                // 3. Jump to Next Field
                if (targetInput.id === 'barcode') {
                    document.getElementById('barcode2').focus();
                } else if (targetInput.id === 'barcode2') {
                    document.getElementById('barcode3').focus();
                } else if (targetInput.id === 'barcode3') {
                    document.getElementById('plu_code').focus();
                }
                
                // If we weren't focused, blur won't fire on the old element (because it wasn't active), so check manually
                if (!wasFocused) {
                    checkDuplicate(targetInput.id, targetInput.value);
                }
            }

            scanBuffer = '';
        } else {
            // Normal Enter key (not scanner)
            // If in barcode field, just prevent submit and move next
            if (['barcode', 'barcode2', 'barcode3'].indexOf(document.activeElement.id) !== -1) {
                e.preventDefault();
                var current = document.activeElement;
                if (current.id === 'barcode') document.getElementById('barcode2').focus();
                else if (current.id === 'barcode2') document.getElementById('barcode3').focus();
                else if (current.id === 'barcode3') document.getElementById('plu_code').focus();
            }
        }
    } else if (e.key.length === 1) {
        scanBuffer += e.key;
    }
});

// Initialize
document.addEventListener('DOMContentLoaded', function() {
    // Autofocus Barcode on Load
    var barcodeField = document.getElementById('barcode');
    if (barcodeField && !barcodeField.value) {
        barcodeField.focus();
    } else {
        // If barcode filled (Edit mode), focus Name
        var nameField = document.querySelector('input[name="name"]');
        if (nameField) nameField.focus();
    }

    // Check if editing a weight product
    var type = document.querySelector('input[name="type"]').value;
    if (type === 'weight') {
        document.getElementById('is_weight').checked = true;
    }
    toggleWeightMode();
    
    // Attach calculation listeners
    document.getElementById('pack_purchase_price').addEventListener('input', calculateUnitPrice);
    document.getElementById('pack_unit_quantity').addEventListener('input', calculateUnitPrice);
});

function toggleWeightMode() {
    var isWeight = document.getElementById('is_weight').checked;
    var typeInput = document.querySelector('input[name="type"]');
    
    // Update Hidden Type
    typeInput.value = isWeight ? 'weight' : 'unit';

    // Labels
    if (isWeight) {
        // Weight Mode (Sack -> Kg)
        document.getElementById('lbl_pack_type').textContent = 'نوع العبوة (شوال/كيس)';
        document.getElementById('lbl_pack_qty').textContent = 'وزن العبوة (كجم)';
        document.getElementById('help_pack_qty').textContent = 'مثال: 50.5 (وزن الشوال)';
        
        document.getElementById('lbl_pack_buy').textContent = 'سعر شراء العبوة كاملة';
        document.getElementById('lbl_unit_buy').textContent = 'سعر شراء الكيلو *';
        
        document.getElementById('lbl_pack_sell').textContent = 'سعر بيع العبوة كاملة';
        document.getElementById('lbl_unit_sell').textContent = 'سعر بيع الكيلو *';
        
        // Steps
        document.getElementById('pack_unit_quantity').setAttribute('step', '0.001');
        document.getElementById('pack_unit_quantity').setAttribute('min', '0.001');
    } else {
        // Unit Mode (Pack -> Piece)
        document.getElementById('lbl_pack_type').textContent = 'نوع التعبئة';
        document.getElementById('lbl_pack_qty').textContent = 'عدد القطع في الوحدة';
        document.getElementById('help_pack_qty').textContent = 'كم قطعة في كل وحدة (كرتونة/لفة)';
        
        document.getElementById('lbl_pack_buy').textContent = 'سعر شراء الوحدة الكاملة (الجملة)';
        document.getElementById('lbl_unit_buy').textContent = 'سعر شراء القطعة الواحدة *';
        
        document.getElementById('lbl_pack_sell').textContent = 'سعر بيع الوحدة الكاملة (الجملة)';
        document.getElementById('lbl_unit_sell').textContent = 'سعر بيع القطعة الواحدة *';
        
        // Steps
        document.getElementById('pack_unit_quantity').setAttribute('step', '1');
        document.getElementById('pack_unit_quantity').setAttribute('min', '1');
    }
}

function calculateUnitPrice() {
    var packPrice = parseFloat(document.getElementById('pack_purchase_price').value) || 0;
    var packQty = parseFloat(document.getElementById('pack_unit_quantity').value) || 1;
    if (packPrice > 0 && packQty > 0) {
        var unitPrice = packPrice / packQty;
        document.getElementById('purchase_price').value = unitPrice.toFixed(3);
    }
}

// ==========================================
// CLIENT-SIDE DUPLICATE VALIDATION
// ==========================================
var duplicateFlags = { barcode: false, plu_code: false };

function checkDuplicate(field, value) {
    var warningDiv = document.getElementById(field + '_warning');
    var input = document.getElementById(field);
    
    // Clear if empty
    if (!value || !value.trim()) {
        warningDiv.style.display = 'none';
        input.style.borderColor = '';
        duplicateFlags[field] = false;
        return;
    }
    
    // Get exclude_id (for edit mode)
    var idInput = document.querySelector('input[name="id"]');
    var excludeId = idInput ? idInput.value : '';
    
    var url = '?page=products&action=checkDuplicate&field=' + field + 
              '&value=' + encodeURIComponent(value.trim()) + 
              '&exclude_id=' + excludeId;
    
    fetch(url)
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.exists) {
                // Show warning
                warningDiv.innerHTML = '⚠️ ' + data.message;
                warningDiv.style.display = 'block';
                input.style.borderColor = '#e74c3c';
                input.style.boxShadow = '0 0 0 2px rgba(231,76,60,0.2)';
                duplicateFlags[field] = true;
            } else {
                // Clear warning
                warningDiv.style.display = 'none';
                input.style.borderColor = '#27ae60';
                input.style.boxShadow = '0 0 0 2px rgba(39,174,96,0.2)';
                duplicateFlags[field] = false;
                // Reset border after 1.5s
                setTimeout(function() {
                    input.style.borderColor = '';
                    input.style.boxShadow = '';
                }, 1500);
            }
        })
        .catch(function(err) {
            console.error('Duplicate check error:', err);
        });
}

// Block form submission if duplicates exist
document.getElementById('productForm').addEventListener('submit', function(e) {
    if (duplicateFlags.barcode || duplicateFlags.plu_code) {
        e.preventDefault();
        var msg = '⚠️ لا يمكن حفظ المنتج:\n';
        if (duplicateFlags.barcode) msg += '- الباركود مكرر\n';
        if (duplicateFlags.plu_code) msg += '- كود PLU مكرر\n';
        msg += '\nالرجاء تغيير القيم المكررة أولاً.';
        alert(msg);
        return false;
    }
});
</script>
